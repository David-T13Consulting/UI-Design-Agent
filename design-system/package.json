    "@storybook/react-vite": "8.4.7",
    "@storybook/test": "8.4.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
